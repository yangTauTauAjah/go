            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.access_token) {",
                  "    pm.collectionVariables.set('tokenUserLama', jsonData.access_token);",
                  "    pm.collectionVariables.set('tokenUser', jsonData.access_token);",
