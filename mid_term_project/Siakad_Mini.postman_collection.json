{
  "info": {
    "name": "SIAKAD Mini",
    "description": "RESTful API untuk sistem akademik mini (Go + Fiber + PostgreSQL). Mendukung 10 endpoint sesuai UTS PBE: auth (login/me), students (CRUD admin), courses, enrollments (mahasiswa).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1",
      "type": "string"
    },
    {
      "key": "contentType",
      "value": "application/json",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "mhsToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Health Check",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Auth",
      "item": [
        {
          "name": "POST /auth/login (admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('adminToken', json.data.access_token);",
                  "  console.log('adminToken tersimpan:', json.data.access_token.substring(0,20) + '...');",
                  "}",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "{{contentType}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@siakad.test\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "POST /auth/login (mahasiswa)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.access_token) {",
                  "  pm.collectionVariables.set('mhsToken', json.data.access_token);",
                  "  console.log('mhsToken tersimpan:', json.data.access_token.substring(0,20) + '...');",
                  "}",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "{{contentType}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"mhs01@siakad.test\",\n  \"password\": \"187221000002\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "GET /auth/me",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "POST /auth/login (salah password → 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));",
                  "pm.test('Kode UNAUTHORIZED', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.code).to.eql('UNAUTHORIZED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "{{contentType}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@siakad.test\",\n  \"password\": \"salah\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            }
          }
        }
      ]
    },
    {
      "name": "3. Students",
      "item": [
        {
          "name": "GET /students (admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/students?page=1&limit=10&search=20241&sort=nim&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["students"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" },
                { "key": "search", "value": "20241" },
                { "key": "sort", "value": "nim" },
                { "key": "order", "value": "asc" }
              ]
            }
          }
        },
        {
          "name": "GET /students (tanpa token → 401)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/students",
              "host": ["{{baseUrl}}"],
              "path": ["students"]
            }
          }
        },
        {
          "name": "POST /students (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "{{contentType}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"202410000099@siakad.test\",\n  \"nim\": \"202410000099\",\n  \"nama\": \"Mahasiswa Baru\",\n  \"prodi\": \"Teknik Informatika\",\n  \"angkatan\": 2024,\n  \"ipk_terakhir\": 3.25\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/students",
              "host": ["{{baseUrl}}"],
              "path": ["students"]
            }
          }
        },
        {
          "name": "GET /students/:id (mahasiswa)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{mhsToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/students/1",
              "host": ["{{baseUrl}}"],
              "path": ["students", "1"]
            }
          }
        },
        {
          "name": "PUT /students/:id (admin)",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "{{contentType}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Mahasiswa Updated\",\n  \"ipk_terakhir\": 3.75\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/students/1",
              "host": ["{{baseUrl}}"],
              "path": ["students", "1"]
            }
          }
        },
        {
          "name": "DELETE /students/:id (admin)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/students/99",
              "host": ["{{baseUrl}}"],
              "path": ["students", "99"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Courses",
      "item": [
        {
          "name": "GET /courses (mahasiswa)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{mhsToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses?semester=1&available_only=true",
              "host": ["{{baseUrl}}"],
              "path": ["courses"],
              "query": [
                { "key": "semester", "value": "1" },
                { "key": "available_only", "value": "true" }
              ]
            }
          }
        },
        {
          "name": "GET /courses (admin)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/courses",
              "host": ["{{baseUrl}}"],
              "path": ["courses"]
            }
          }
        }
      ]
    },
    {
      "name": "5. Enrollments",
      "item": [
        {
          "name": "POST /enrollments (mahasiswa)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{mhsToken}}" },
              { "key": "Content-Type", "value": "{{contentType}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": 1,\n  \"tahun_akademik\": \"2026/2027Ganjil\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/enrollments",
              "host": ["{{baseUrl}}"],
              "path": ["enrollments"]
            }
          }
        },
        {
          "name": "POST /enrollments duplikat (→ 409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 409', () => pm.response.to.have.status(409));",
                  "pm.test('Kode CONFLICT', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.code).to.eql('CONFLICT');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{mhsToken}}" },
              { "key": "Content-Type", "value": "{{contentType}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"course_id\": 1,\n  \"tahun_akademik\": \"2026/2027Ganjil\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/enrollments",
              "host": ["{{baseUrl}}"],
              "path": ["enrollments"]
            }
          }
        },
        {
          "name": "DELETE /enrollments/:id (mahasiswa)",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{mhsToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/enrollments/1",
              "host": ["{{baseUrl}}"],
              "path": ["enrollments", "1"]
            }
          }
        }
      ]
    }
  ]
}
