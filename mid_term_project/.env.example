# Salin berkas ini menjadi `.env` lalu isi nilai yang sesuai.

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=siakad
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable

# JWT (WAJIB ≥32 karakter)
JWT_SECRET=ganti-dengan-secret-minimal-32-karakter-yang-aman
JWT_ISSUER=siakad-mini
JWT_ACCESS_TTL_MINUTES=60

# Server
APP_PORT=3000
APP_READ_TIMEOUT=15
APP_WRITE_TIMEOUT=15
LOG_LEVEL=info

# CORS (pisahkan dengan koma)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Seed admin default
SEED_ADMIN_EMAIL=admin@siakad.test
SEED_ADMIN_PASSWORD=admin123